    "priority": {
      "riskEdges": ["0.05", "0.2", "0.5", "0.8"],
      "tierSteps": {"small": 0, "medium": 1, "above": 2}
    },
    "familiarity": {
      "carryingFacts": 3,
      "floor": 20,
      "marginFloor": "0.2"
    }
  }
