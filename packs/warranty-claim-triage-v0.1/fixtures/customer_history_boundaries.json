  "featureSet": {
    "schemaVersion": "1.0",
    "id": "customerClaimActivity",
    "appliesTo": ["customer"],
    "features": [
      {"name": "claimsFiled90d", "type": "integer", "op": "count", "window": "90d", "current": "exclude", "where": {"eventType": "claim.filed"}},
      {"name": "claimsFiled30d", "type": "integer", "op": "count", "window": "30d", "current": "exclude", "where": {"eventType": "claim.filed"}},
      {
        "name": "totalClaimed90d",
        "type": "money",
        "op": "sum",
        "field": "data.amount",
        "currency": {"current": "data.currency"},
        "window": "90d",
        "current": "exclude",
        "where": {"eventType": "claim.filed"}
      },
      {
        "name": "confirmedAbuseFindings365d",
        "type": "integer",
        "op": "count",
        "window": "365d",
        "current": "exclude",
        "where": {
          "all": [
            {"eventType": "claim.investigated"},
            {"eq": [{"field": "data.investigationFinding"}, {"value": "abuse_confirmed"}]}
          ]
        }
      },
      {"name": "lastClaimAt", "type": "timestamp", "op": "lastSeen", "window": "365d", "current": "exclude", "where": {"eventType": "claim.filed"}},
      {"name": "purchases365d", "type": "integer", "op": "count", "window": "365d", "current": "exclude", "where": {"eventType": "purchase.completed"}},
      {"name": "services365d", "type": "integer", "op": "count", "window": "365d", "current": "exclude", "where": {"eventType": "service.completed"}},
      {"name": "tenureDays", "type": "integer", "op": "lookup", "source": "customerProfile", "field": "tenureDays", "maxAge": "30d"},
      {"name": "tier", "type": "text", "op": "lookup", "source": "customerProfile", "field": "tier", "maxAge": "30d"}
    ]
  },
  "compute": {"eventId": "current"},
  "expect": {
    "features": {
      "claimsFiled90d": 3,
      "claimsFiled30d": 2,
      "totalClaimed90d": {"amount": "150.00", "currency": "USD"},
